                        <div className="col-12 pt-4">


                            <Stack spacing={4}>
                                <InputGroup>
                                    <InputLeftElement
                                        width='90px'
                                        display="flex"
                                        className="justify-content-start"
                                        pointerEvents='none'
                                    >
                                        <span className={error.some(err => err.category === 'name') ? "text-danger" : ""}>姓名</span>


                                    </InputLeftElement>
                                    <Input
                                        variant={"ghost"}
                                        paddingLeft="90px"
                                        type='tel'
                                        value={name}
                                        placeholder='Name'
                                        onChange={e => setName(e.target.value)}
                                    />
                                </InputGroup>

                                <InputGroup>
                                    <InputLeftElement
                                        width='90px'
                                        display="flex"
                                        className="justify-content-start"
                                        pointerEvents='none'

                                    >
                                        <span className={error.some(err => err.category === 'phone') ? "text-danger" : ""}>電話</span>


                                    </InputLeftElement>
                                    <Input
                                        variant={"ghost"}
