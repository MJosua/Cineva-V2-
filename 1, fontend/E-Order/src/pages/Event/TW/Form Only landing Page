function Landingpagetw() {

    const toast = useToast();

    const { isOpen, onOpen, onClose } = useDisclosure()
    const [inputCode, setInputCode] = useState(false)

    const {
        isOpen: isOpenModalSuccess,
        onOpen: onOpenModalSuccess,
        onClose: oncCloseModalSuccess,
    } = useDisclosure();


    const [event_id, setEvent_id] = useState(1)
    const [country, setCountry] = useState(765)

    const [name, setName] = useState("")
    const [phone, setPhone] = useState("")
    const [channel, setChannel] = useState("")
    const [invoice, setInvoice] = useState("")
    const [date, setDate] = useState("")

    const [error, setError] = useState([])
    const [isLoading, setIsLoading] = useState(false)


    const handleInput = () => {
        console.log("Jalan")
        let hasError = false;

        // Validate type
        if (name.trim() === "") {

            setError(prevErrors => [
                ...prevErrors,
                { category: 'name', message: "Please select name of support." }
            ]);
            hasError = true;
        } else {
            setError(prevErrors => prevErrors.filter(error => error.category !== 'name'));
        }

        // Validate issue description
        if (phone.trim() === "") {

            setError(prevErrors => [
                ...prevErrors,
                { category: 'phone', message: "Please provide a valid issue description." }
            ]);
            hasError = true;

        } else {
            setError(prevErrors => prevErrors.filter(error => error.category !== 'phone'));
        }

        if (channel.trim() === "") {

            setError(prevErrors => [
                ...prevErrors,
                { category: 'channel', message: "Please provide a valid issue description." }
            ]);
            hasError = true;
        } else {
            setError(prevErrors => prevErrors.filter(error => error.category !== 'channel'));
        }

        if (invoice.trim() === "") {

            setError(prevErrors => [
                ...prevErrors,
                { category: 'invoice', message: "Please provide a valid issue description." }
            ]);
            hasError = true;
        } else {
            setError(prevErrors => prevErrors.filter(error => error.category !== 'invoice'));
        }

        

        // If no errors, proceed with API calls
        if (!hasError && error.length === 0) {
            setIsLoading(true);
            axios.post(`${API_URL}/event/doorprize`,
                {
                    Event_id: "1",
                    Country: "765",

                    column_1: name,
                    column_2: phone,
                    column_3: channel,
                    column_4: invoice,
                    column_5: date,

                    queryUnique : 4,

                },

            )
                .then(response => {

                    if (response.status === 200) {
                        onOpenModalSuccess();

                        setName("")
                        setPhone("")
                        setChannel("")
                        setInvoice("")
                        setDate(new Date())
                        setInputCode(false)

                    }else{
                        toast({
                            title: "Error",
                            description: response.data.message,
                            status: "error",
                            duration: 3000,
                            isClosable: true,
                        });
                        
                    }
                })
                .catch(error => {
                    toast({
                        title: "Error",
                        description: error.response.data.message || "An error occurred.",
                        status: "error",
                        duration: 3000,
                        isClosable: true,
                    });

                })
                .finally(() => {
                    setIsLoading(false);
                });
        } else {
            toast({
                title: "check again and press sumbit",
                duration: 3000,
                isClosable: true,
            });
        }
    }

