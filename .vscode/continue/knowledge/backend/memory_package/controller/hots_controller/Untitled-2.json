{
    "id": "6",
    "title": "NOODLE Sample Request Form",
    "url": "/sample-request-form",
    "category": "HRGA",
    "description": "Request product samples \nfor marketing or testing",
    "apiEndpoint": "/api/sample-request-form",
    "items": [
        {
            "id": "field-nametitle",
            "type": "field",
            "order": 0,
            "data": {
                "label": "Name/title",
                "name": "nametitle",
                "type": "text",
                "required": true,
                "columnSpan": 1,
                "default": "${user}"
            }
        },
        {
            "id": "field-deliver-to",
            "type": "field",
            "order": 1,
            "data": {
                "label": "Deliver To",
                "name": "deliver_to",
                "type": "suggestion-insert",
                "required": false,
                "columnSpan": 1,
                "options": [
                    "${linkeddistributors}"
                ],
                "dependerOf": [
                    "field_1751275073662"
                ]
            }
        },
        {
            "id": "field-delivery-method",
            "type": "field",
            "order": 2,
            "data": {
                "label": "Delivery Method",
                "name": "delivery_method",
                "type": "select",
                "required": false,
                "columnSpan": 1,
                "options": [
                    "Delivery",
                    "Pickup"
                ]
            }
        },
        {
            "id": "field-purpose",
            "type": "field",
            "order": 3,
            "data": {
                "label": "Purpose",
                "name": "purpose",
                "type": "select",
                "required": false,
                "columnSpan": 3,
                "options": [
                    "${srf_purpose}"
                ]
            }
        },
        {
            "id": "field-product-category",
            "type": "field",
            "order": 4,
            "data": {
                "label": "Product Category",
                "name": "Product_Category",
                "type": "select",
                "required": false,
                "columnSpan": 1,
                "options": [
                    "Noodle",
                    "Snack",
                    "Dairy",
                    "NICI/FS"
                ],
                "dependerOf": [
                    "item_name"
                ]
            }
        },
        {
            "id": "field-1760596991065",
            "type": "field",
            "order": 5,
            "data": {
                "label": "PO Number",
                "name": "PO_Number",
                "type": "suggestion-insert",
                "required": false,
                "columnSpan": 1,
                "options": [
                    "${ponumber}"
                ],
                "rules": [
                    {
                        "dependsBy": "deliver_to",
                        "when": {
                            "operator": "not_empty"
                        },
                        "then": {
                            "api": "/hots_settings/get_srf_po/${dependsByValue}",
                            "storeAs": "ponumber",
                            "dependsByValue": "filter"
                        }
                    }
                ]
            }
        },
        {
            "id": "field-factory",
            "type": "field",
            "order": 6,
            "data": {
                "label": "Factory",
                "name": "field_1751275073662",
                "type": "select",
                "required": false,
                "columnSpan": 1,
                "options": [
                    "${factoryplants}"
                ],
                "placeholder": "Select ( Leave Empty for FS )"
            }
        },
        {
            "id": "field-week-delivery",
            "type": "field",
            "order": 7,
            "data": {
                "label": "Week Delivery",
                "name": "Week Delivery",
                "type": "number",
                "required": false,
                "columnSpan": 1,
                "default": "",
                "placeholder": "Fill Week number, left empty if none"
            }
        },
        {
            "id": "field-1760594325418",
            "type": "field",
            "order": 8,
            "data": {
                "label": "Category",
                "name": "Category_field",
                "type": "select",
                "required": false,
                "columnSpan": 1,
                "options": [
                    "${srfsamplecategoryes}"
                ]
            }
        },
        {
            "id": "rowgroup-items",
            "type": "rowgroup",
            "order": 9,
            "data": {
                "title": "Items",
                "isStructuredInput": true,
                "maxRows": 5,
                "structure": {
                    "firstColumn": {
                        "label": "Item Name",
                        "name": "item_name",
                        "type": "suggestion-insert",
                        "placeholder": "Enter item name",
                        "options": [
                            "${skulist}"
                        ],
                        "dependsOn": "Category_field",
                        "dependsOnValue": "filter",
                        "dependsByValue": "filter"
                    },
                    "secondColumn": {
                        "label": "Quantity",
                        "name": "quantity",
                        "type": "number",
                        "placeholder": "Enter quantity",
                        "rounding": "25",
                        "maxnumber": "9999",
                        "rules": [
                            {
                                "dependsBy": "Category_field",
                                "when": {
                                    "operator": "equals",
                                    "value": "RM - Empty Carton"
                                },
                                "then": {
                                    "rounding": 25
                                }
                            },
                            {
                                "default": true,
                                "then": {
                                    "rounding": "0"
                                }
                            }
                        ]
                    },
                    "thirdColumn": {
                        "label": "Unit",
                        "name": "unit",
                        "type": "select",
                        "options": [
                            "${typesrf}"
                        ],
                        "placeholder": "Select unit",
                        "dependsOn": "field_1751274972416_copy_1759808532363",
                        "dependsByValue": "filter",
                        "dependsOnValue": "filter"
                    },
                    "combinedMapping": "second_third"
                },
                "rowGroup": [
                    {
                        "id": "row_1756266314872",
                        "firstValue": "",
                        "secondValue": "",
                        "thirdValue": ""
                    }
                ]
            }
        }
    ],
    "servis_aktif": 1,
    "active": 1,
    "approval": {
        "steps": [
            "Manager",
            "IT Team"
        ],
        "mode": "sequential"
    },
    "submit": {
        "label": "Submit",
        "type": "button",
        "action": "/submit-sample-request"
    }
}