{
  "template_code": "IV_DAILY_INPUT",
  "version": 2,
  "target": "staging.iv_daily_input",
  "description": "IndoVietnam daily input workbook v2 — one file per stock point (warehouse) per day, generic for all stock points (chosen once on sheet INFO, cell B1). Only what IOD/HOTS cannot know is typed: deliveries, container numbers received, transfers, physical count. Product/batch/expiry/quantity of containers come from IOD (trs_realization_batch); stock out is allocated FEFO by enrich/dailyStock.js (decision V18). Supersedes IV_SP3_DAILY_INPUT (v1).",
  "scope": {
    "program": "cto",
    "distributor_company_id": 216,
    "division_id": 1,
    "hots_company_id": 4
  },
  "fingerprint": {
    "file_name": [
      "IV_Daily_*.xlsx",
      "IV_*Daily_Input*.xlsx"
    ],
    "sheets_all": [
      "INFO",
      "DELIVERY",
      "STOCK_IN",
      "TRANSFER",
      "STOCK_CLOSING",
      "LISTS"
    ],
    "header_tokens": [
      {
        "sheet": "STOCK_IN",
        "rows": "1:1",
        "contains": [
          "Container No"
        ]
      }
    ],
    "min_score": 0.66
  },
  "sheets": [
    {
      "match": "DELIVERY",
      "optional": true,
      "mode": "unpivot",
      "header": {
        "row": 1
      },
      "constants_from_cells": {
        "stock_point": {
          "sheet": "INFO",
          "cell": "B1",
          "transform": [
            "string",
            "upper"
          ]
        }
      },
      "unpivot": {
        "id_columns": {
          "event_date": {
            "from": "col:A",
            "transform": [
              "excel_date"
            ]
          },
          "delivery_plan_date": {
            "from": "col:B",
            "transform": [
              "excel_date"
            ]
          },
          "delivery_order_no": {
            "from": "col:C",
            "transform": [
              "string",
              "upper"
            ]
          },
          "sales_agent": {
            "from": "col:D",
            "transform": [
              "trim"
            ]
          },
          "shop_name": {
            "from": "col:E",
            "transform": [
              "trim"
            ]
          },
          "address": {
            "from": "col:F",
            "transform": [
              "trim"
            ]
          },
          "district": {
            "from": "col:G",
            "transform": [
              "string"
            ]
          },
          "channel": {
            "from": "col:H",
            "transform": [
              "string"
            ]
          },
          "vehicle_code": {
            "from": "col:I",
            "transform": [
              "string"
            ]
          }
        },
        "value_columns": "J:U",
        "key_field": "product_group_label",
        "key_transform": [
          "string"
        ],
        "value_field": "qty_ctn"
      },
      "skip_when": {
        "field": "event_date",
        "op": "empty"
      },
      "constants": {
        "record_type": "DELIVERY",
        "uom": "CTN"
      }
    },
    {
      "match": "STOCK_IN",
      "optional": true,
      "mode": "rows",
      "header": {
        "row": 1
      },
      "constants_from_cells": {
        "stock_point": {
          "sheet": "INFO",
          "cell": "B1",
          "transform": [
            "string",
            "upper"
          ]
        }
      },
      "columns": {
        "event_date": {
          "from": "col:A",
          "transform": [
            "excel_date"
          ]
        },
        "source": {
          "from": "col:B",
          "transform": [
            "string"
          ]
        },
        "container_no": {
          "from": "col:C",
          "transform": [
            "string",
            "upper"
          ]
        },
        "product_group": {
          "from": "col:D",
          "transform": [
            "string",
            "upper"
          ]
        },
        "qty_ctn": {
          "from": "col:E",
          "transform": [
            "number"
          ]
        },
        "expiry_date": {
          "from": "col:F",
          "transform": [
            "excel_date"
          ]
        },
        "note": {
          "from": "col:G",
          "transform": [
            "trim"
          ]
        }
      },
      "skip_when": {
        "field": "event_date",
        "op": "empty"
      },
      "constants": {
        "record_type": "STOCK_IN",
        "uom": "CTN"
      }
    },
    {
      "match": "TRANSFER",
      "optional": true,
      "mode": "rows",
      "header": {
        "row": 1
      },
      "constants_from_cells": {
        "stock_point": {
          "sheet": "INFO",
          "cell": "B1",
          "transform": [
            "string",
            "upper"
          ]
        }
      },
      "columns": {
        "event_date": {
          "from": "col:A",
          "transform": [
            "excel_date"
          ]
        },
        "to_stock_point": {
          "from": "col:B",
          "transform": [
            "string",
            "upper"
          ]
        },
        "vehicle_code": {
          "from": "col:C",
          "transform": [
            "string"
          ]
        },
        "product_group": {
          "from": "col:D",
          "transform": [
            "string",
            "upper"
          ]
        },
        "qty_ctn": {
          "from": "col:E",
          "transform": [
            "number"
          ]
        },
        "note": {
          "from": "col:F",
          "transform": [
            "trim"
          ]
        }
      },
      "skip_when": {
        "field": "event_date",
        "op": "empty"
      },
      "constants": {
        "record_type": "TRANSFER_OUT",
        "uom": "CTN"
      }
    },
    {
      "match": "STOCK_CLOSING",
      "optional": true,
      "mode": "unpivot",
      "header": {
        "row": 1
      },
      "constants_from_cells": {
        "stock_point": {
          "sheet": "INFO",
          "cell": "B1",
          "transform": [
            "string",
            "upper"
          ]
        }
      },
      "unpivot": {
        "id_columns": {
          "event_date": {
            "from": "col:A",
            "transform": [
              "excel_date"
            ]
          },
          "expiry_date": {
            "from": "col:B",
            "transform": [
              "excel_date"
            ]
          }
        },
        "value_columns": "C:H",
        "key_field": "product_group_label",
        "key_transform": [
          "string"
        ],
        "value_field": "qty_ctn"
      },
      "skip_when": {
        "field": "event_date",
        "op": "empty"
      },
      "constants": {
        "record_type": "CLOSING",
        "uom": "CTN"
      }
    }
  ],
  "required": [
    "event_date",
    "record_type",
    "stock_point"
  ],
  "rules": [
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "in",
            "value": [
              "DELIVERY",
              "CLOSING"
            ]
          },
          {
            "field": "qty_ctn",
            "op": "=",
            "value": 0
          }
        ]
      },
      "then": {
        "skip": true
      }
    },
    {
      "when": {
        "field": "product_group_label",
        "op": "matches",
        "value": "Promo"
      },
      "then": {
        "set": {
          "line_type": "PROMO"
        }
      }
    },
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "=",
            "value": "DELIVERY"
          },
          {
            "field": "product_group_label",
            "op": "matches",
            "value": "Sales"
          }
        ]
      },
      "then": {
        "set": {
          "line_type": "SALES"
        }
      }
    },
    {
      "when": {
        "field": "product_group_label",
        "op": "matches",
        "value": "^IIP"
      },
      "then": {
        "set": {
          "product_group": "IIP"
        }
      }
    },
    {
      "when": {
        "field": "product_group_label",
        "op": "matches",
        "value": "^GSS"
      },
      "then": {
        "set": {
          "product_group": "GSS"
        }
      }
    },
    {
      "when": {
        "field": "product_group_label",
        "op": "matches",
        "value": "^GRS"
      },
      "then": {
        "set": {
          "product_group": "GRS"
        }
      }
    },
    {
      "when": {
        "field": "product_group_label",
        "op": "matches",
        "value": "^GPD"
      },
      "then": {
        "set": {
          "product_group": "GPD"
        }
      }
    },
    {
      "when": {
        "field": "product_group_label",
        "op": "matches",
        "value": "^IHAG"
      },
      "then": {
        "set": {
          "product_group": "IHAG"
        }
      }
    },
    {
      "when": {
        "field": "product_group_label",
        "op": "matches",
        "value": "^PGSS"
      },
      "then": {
        "set": {
          "product_group": "PGSS"
        }
      }
    },
    {
      "when": {
        "field": "qty_ctn",
        "op": "<",
        "value": 0
      },
      "then": {
        "error": "NEGATIVE_QTY"
      }
    },
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "=",
            "value": "DELIVERY"
          },
          {
            "field": "sales_agent",
            "op": "empty"
          }
        ]
      },
      "then": {
        "warning": "AGENT_MISSING"
      }
    },
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "=",
            "value": "DELIVERY"
          },
          {
            "field": "vehicle_code",
            "op": "empty"
          }
        ]
      },
      "then": {
        "warning": "VEHICLE_MISSING"
      }
    },
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "=",
            "value": "DELIVERY"
          },
          {
            "field": "shop_name",
            "op": "empty"
          }
        ]
      },
      "then": {
        "error": "SHOP_MISSING"
      }
    },
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "=",
            "value": "STOCK_IN"
          },
          {
            "field": "source",
            "op": "empty"
          }
        ]
      },
      "then": {
        "error": "STOCK_IN_SOURCE_REQUIRED"
      }
    },
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "=",
            "value": "STOCK_IN"
          },
          {
            "field": "source",
            "op": "matches",
            "value": "port"
          },
          {
            "field": "container_no",
            "op": "empty"
          }
        ]
      },
      "then": {
        "error": "CONTAINER_NO_REQUIRED_FROM_PORT"
      }
    },
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "=",
            "value": "STOCK_IN"
          },
          {
            "field": "container_no",
            "op": "empty"
          },
          {
            "field": "product_group",
            "op": "empty"
          }
        ]
      },
      "then": {
        "error": "STOCK_IN_NEEDS_CONTAINER_OR_PRODUCT_GROUP"
      }
    },
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "=",
            "value": "TRANSFER_OUT"
          },
          {
            "field": "to_stock_point",
            "op": "empty"
          }
        ]
      },
      "then": {
        "error": "TRANSFER_DESTINATION_REQUIRED"
      }
    },
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "=",
            "value": "TRANSFER_OUT"
          },
          {
            "field": "product_group",
            "op": "empty"
          }
        ]
      },
      "then": {
        "error": "TRANSFER_PRODUCT_GROUP_REQUIRED"
      }
    },
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "=",
            "value": "TRANSFER_OUT"
          },
          {
            "field": "qty_ctn",
            "op": "empty"
          }
        ]
      },
      "then": {
        "error": "TRANSFER_QTY_REQUIRED"
      }
    },
    {
      "when": {
        "all": [
          {
            "field": "record_type",
            "op": "=",
            "value": "CLOSING"
          },
          {
            "field": "expiry_date",
            "op": "empty"
          }
        ]
      },
      "then": {
        "error": "EXPIRY_DATE_REQUIRED"
      }
    }
  ]
}
