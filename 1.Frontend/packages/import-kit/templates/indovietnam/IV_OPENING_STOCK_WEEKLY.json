{
  "template_code": "IV_OPENING_STOCK_WEEKLY",
  "target": "staging.iv_opening_stock_weekly",
  "description": "IndoVietnam weekly opening stock (PCS) per SKU and block (Vietnam, Key Group HCM/HN, buyers, IV HCM/HN, stock points SP1…SB-HN). Sheets 'OS 2025' / 'OS 2026'. SKU in column A, weeks from column B.",
  "scope": {
    "program": "cto",
    "distributor_company_id": 216,
    "division_id": 1,
    "hots_company_id": 4
  },
  "fingerprint": {
    "file_name": [
      "*By WH*.xlsx"
    ],
    "sheets_any": [
      "OS 2026",
      "OS 2025"
    ],
    "header_tokens": [
      {
        "sheet": "OS 2026",
        "rows": "2:3",
        "contains": [
          "Opening Stock"
        ]
      }
    ],
    "min_score": 0.66
  },
  "sheets": [
    {
      "match_regex": "^OS \\d{4}$",
      "mode": "unpivot",
      "header": {
        "row": 3
      },
      "constants_from_sheet_name": {
        "year": "(\\d{4})"
      },
      "constants": {
        "uom": "PCS",
        "segment_label": "Opening Stock (Vietnam)"
      },
      "carry": [
        {
          "field": "segment_label",
          "column": "A",
          "row_when": {
            "column": "B",
            "op": "=",
            "value": 1
          },
          "skip_row": true
        }
      ],
      "unpivot": {
        "id_columns": {
          "sku_name": {
            "from": "A",
            "transform": [
              "string"
            ]
          }
        },
        "key_row": 3,
        "key_field": "week",
        "value_field": "qty_pcs",
        "value_columns": "B:BA",
        "note": "Explicit week range: the header row also holds YTD columns (BD=38, BE=40 / BC, BD) whose numbers fall in 1..53 — never use value_columns_where here."
      },
      "skip_when": {
        "field": "sku_name",
        "op": "in",
        "value": [
          "",
          "Total",
          "0",
          "Jan"
        ]
      }
    }
  ],
  "required": [
    "sku_name",
    "week",
    "year"
  ],
  "rules": [
    {
      "when": {
        "all": [
          {
            "field": "year",
            "op": "=",
            "value": "$currentYear"
          },
          {
            "field": "week",
            "op": ">",
            "value": "$cutoffWeek"
          }
        ]
      },
      "then": {
        "set": {
          "is_forecast": true
        }
      }
    },
    {
      "when": {
        "field": "qty_pcs",
        "op": "<",
        "value": 0
      },
      "then": {
        "warning": "NEGATIVE_STOCK"
      }
    }
  ]
}
