{
  "template_code": "IV_SP3_DAILY_INPUT",
  "target": "staging.iv_daily_input",
  "description": "New IndoVietnam daily input workbook v1 (one file per stock point per day; generated by 3.Knowledge/build_iv_sp3_daily_input_template_2026_10_06.js). record_type: DELIVERY (shop × product group × SALES/PROMO), STOCK_IN (container or transfer in, per expiry), TRANSFER_OUT (from → to, per expiry), CLOSING (physical count per expiry). Cartons. Names come from dropdowns (sheet LISTS); weekly/monthly are calculated, never uploaded (V17).",
  "scope": { "program": "cto", "distributor_company_id": 216, "division_id": 1, "hots_company_id": 4, "stock_point": "SP3" },
  "fingerprint": {
    "file_name": ["IV_SP3_Daily*.xlsx"],
    "sheets_all": ["DELIVERY", "STOCK_IN", "TRANSFER", "STOCK_CLOSING", "LISTS"],
    "header_tokens": [{ "sheet": "DELIVERY", "rows": "1:1", "contains": ["Delivery Date", "Sales Agent", "Vehicle"] }],
    "min_score": 0.66
  },
  "sheets": [
    {
      "match": "DELIVERY", "optional": true, "mode": "unpivot", "header": { "row": 1 },
      "unpivot": {
        "id_columns": {
          "event_date": { "from": "col:A", "transform": ["excel_date"] },
          "delivery_plan_date": { "from": "col:B", "transform": ["excel_date"] },
          "delivery_order_no": { "from": "col:C", "transform": ["string", "upper"] },
          "sales_agent": { "from": "col:D", "transform": ["trim"] },
          "shop_name": { "from": "col:E", "transform": ["trim"] },
          "address": { "from": "col:F", "transform": ["trim"] },
          "district": { "from": "col:G", "transform": ["string"] },
          "channel": { "from": "col:H", "transform": ["string"] },
          "vehicle_code": { "from": "col:I", "transform": ["string"] }
        },
        "value_columns": "J:U",
        "key_field": "product_group_label",
        "key_transform": ["string"],
        "value_field": "qty_ctn"
      },
      "skip_when": { "field": "event_date", "op": "empty" },
      "constants": { "record_type": "DELIVERY", "stock_point": "SP3", "uom": "CTN" }
    },
    {
      "match": "STOCK_IN", "optional": true, "mode": "rows", "header": { "row": 1 },
      "columns": {
        "event_date": { "from": "col:A", "transform": ["excel_date"] },
        "source": { "from": "col:B", "transform": ["string"] },
        "container_no": { "from": "col:C", "transform": ["string", "upper"] },
        "expiry_date": { "from": "col:D", "transform": ["excel_date"] },
        "product_group": { "from": "col:E", "transform": ["string", "upper"] },
        "qty_ctn": { "from": "col:F", "transform": ["number"] },
        "note": { "from": "col:G", "transform": ["trim"] }
      },
      "skip_when": { "field": "event_date", "op": "empty" },
      "constants": { "record_type": "STOCK_IN", "stock_point": "SP3", "uom": "CTN" }
    },
    {
      "match": "TRANSFER", "optional": true, "mode": "rows", "header": { "row": 1 },
      "columns": {
        "event_date": { "from": "col:A", "transform": ["excel_date"] },
        "from_stock_point": { "from": "col:B", "transform": ["string"] },
        "to_stock_point": { "from": "col:C", "transform": ["string"] },
        "vehicle_code": { "from": "col:D", "transform": ["string"] },
        "expiry_date": { "from": "col:E", "transform": ["excel_date"] },
        "product_group": { "from": "col:F", "transform": ["string", "upper"] },
        "qty_ctn": { "from": "col:G", "transform": ["number"] },
        "note": { "from": "col:H", "transform": ["trim"] }
      },
      "skip_when": { "field": "event_date", "op": "empty" },
      "constants": { "record_type": "TRANSFER_OUT", "stock_point": "SP3", "uom": "CTN" }
    },
    {
      "match": "STOCK_CLOSING", "optional": true, "mode": "unpivot", "header": { "row": 1 },
      "unpivot": {
        "id_columns": {
          "event_date": { "from": "col:A", "transform": ["excel_date"] },
          "expiry_date": { "from": "col:B", "transform": ["excel_date"] }
        },
        "value_columns": "C:H",
        "key_field": "product_group_label",
        "key_transform": ["string"],
        "value_field": "qty_ctn"
      },
      "skip_when": { "field": "event_date", "op": "empty" },
      "constants": { "record_type": "CLOSING", "stock_point": "SP3", "uom": "CTN" }
    }
  ],
  "required": ["event_date", "record_type", "qty_ctn"],
  "rules": [
    { "when": { "field": "qty_ctn", "op": "=", "value": 0 }, "then": { "skip": true } },
    { "when": { "field": "product_group_label", "op": "matches", "value": "Promo" }, "then": { "set": { "line_type": "PROMO" } } },
    { "when": { "all": [{ "field": "record_type", "op": "=", "value": "DELIVERY" }, { "field": "product_group_label", "op": "matches", "value": "Sales" }] }, "then": { "set": { "line_type": "SALES" } } },
    { "when": { "field": "product_group_label", "op": "matches", "value": "^IIP" }, "then": { "set": { "product_group": "IIP" } } },
    { "when": { "field": "product_group_label", "op": "matches", "value": "^GSS" }, "then": { "set": { "product_group": "GSS" } } },
    { "when": { "field": "product_group_label", "op": "matches", "value": "^GRS" }, "then": { "set": { "product_group": "GRS" } } },
    { "when": { "field": "product_group_label", "op": "matches", "value": "^GPD" }, "then": { "set": { "product_group": "GPD" } } },
    { "when": { "field": "product_group_label", "op": "matches", "value": "^IHAG" }, "then": { "set": { "product_group": "IHAG" } } },
    { "when": { "field": "product_group_label", "op": "matches", "value": "^PGSS" }, "then": { "set": { "product_group": "PGSS" } } },
    { "when": { "field": "qty_ctn", "op": "<", "value": 0 }, "then": { "error": "NEGATIVE_QTY" } },
    { "when": { "all": [{ "field": "record_type", "op": "=", "value": "DELIVERY" }, { "field": "sales_agent", "op": "empty" }] }, "then": { "warning": "AGENT_MISSING" } },
    { "when": { "all": [{ "field": "record_type", "op": "=", "value": "DELIVERY" }, { "field": "vehicle_code", "op": "empty" }] }, "then": { "warning": "VEHICLE_MISSING" } },
    { "when": { "all": [{ "field": "record_type", "op": "=", "value": "DELIVERY" }, { "field": "shop_name", "op": "empty" }] }, "then": { "error": "SHOP_MISSING" } },
    { "when": { "all": [{ "field": "record_type", "op": "=", "value": "STOCK_IN" }, { "field": "source", "op": "matches", "value": "port" }, { "field": "container_no", "op": "empty" }] }, "then": { "error": "CONTAINER_NO_REQUIRED_FROM_PORT" } },
    { "when": { "all": [{ "field": "record_type", "op": "in", "value": ["STOCK_IN", "TRANSFER_OUT", "CLOSING"] }, { "field": "expiry_date", "op": "empty" }] }, "then": { "error": "EXPIRY_DATE_REQUIRED" } },
    { "when": { "all": [{ "field": "record_type", "op": "=", "value": "TRANSFER_OUT" }, { "field": "to_stock_point", "op": "empty" }] }, "then": { "error": "TRANSFER_DESTINATION_REQUIRED" } },
    { "when": { "all": [{ "field": "record_type", "op": "=", "value": "TRANSFER_OUT" }, { "field": "from_stock_point", "op": "empty" }] }, "then": { "set": { "from_stock_point": "SP3" } } }
  ]
}
