{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "framer-motion": ["./node_modules/framer-motion", "../node_modules/framer-motion"],
      "next-themes": ["./node_modules/next-themes", "../node_modules/next-themes"],
      "react-hook-form": ["./node_modules/react-hook-form", "../node_modules/react-hook-form"],
      "recharts": ["./node_modules/recharts", "../node_modules/recharts"],
      "react-pdf": ["./node_modules/react-pdf", "../node_modules/react-pdf"],
      "@tiptap/react": ["./node_modules/@tiptap/react", "../node_modules/@tiptap/react"],
      "@tiptap/starter-kit": ["./node_modules/@tiptap/starter-kit", "../node_modules/@tiptap/starter-kit"],
      "@tiptap/extension-image": ["./node_modules/@tiptap/extension-image", "../node_modules/@tiptap/extension-image"],
      "@tiptap/extension-link": ["./node_modules/@tiptap/extension-link", "../node_modules/@tiptap/extension-link"]
    }
  },
  "include": ["src"]
}
